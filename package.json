{
  "name": "vault-viewer",
  "version": "0.1.0",
  "description": "Fast local-only viewer for markdown, JSON and text vaults",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "better-sqlite3": "latest",
    "chokidar": "latest",
    "codemirror": "^6.0.2",
    "gray-matter": "latest",
    "highlight.js": "latest",
    "js-yaml": "^4.1.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-highlight": "latest",
    "remark-gfm": "latest",
    "unist-util-visit": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@electron/rebuild": "latest",
    "@types/better-sqlite3": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "latest",
    "electron-vite": "^5.0.0",
    "typescript": "latest",
    "vite": "^7.0.0",
    "vitest": "latest"
  }
}
